# ==============================================================================
# 카카오 API 연동 설정 템플릿 (.env.example)
# ==============================================================================
# 이 파일을 복사하여 .env 파일을 만들고 실제 카카오 발급 키를 입력하세요.
# cp .env.example .env (또는 Windows: copy .env.example .env)

# 1. 카카오 JavaScript 키 (프론트엔드 연동)
KAKAO_JAVASCRIPT_KEY=your_kakao_javascript_key_here

# 2. 카카오 REST API 키 (백엔드 서버 연동)
KAKAO_REST_API_KEY=your_kakao_rest_api_key_here

# 3. 카카오 Client Secret (선택사항)
KAKAO_CLIENT_SECRET=

# 4. 카카오 Admin 키 (선택사항)
KAKAO_ADMIN_KEY=

# 5. 카카오 Redirect URI
KAKAO_REDIRECT_URI=http://localhost:8000/oauth/kakao/callback

# 서버 설정
PORT=8000
FLASK_ENV=production
